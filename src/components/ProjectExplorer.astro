---
import { projects } from '../data/projects';
import { href } from '../lib/paths';
---
<div class="project-explorer">
  <div class="project-filters" role="group" aria-label="Filter projects"><button type="button" disabled data-filter="All" aria-pressed="true">All work</button>{['Sports','Vision','Business'].map(category => <button type="button" disabled data-filter={category} aria-pressed="false">{category}</button>)}<span class="result-count" aria-live="polite">{projects.length} projects</span></div>
  <div class="project-index">{projects.map((project, index) => <article class="index-project" id={project.id} data-category={project.category}>
    <span class="index-number">{String(index + 1).padStart(2, '0')}</span>
    <div class="index-project-main"><div class="project-category"><span>{project.category}</span><span>{project.status}</span></div><h2>{project.title}</h2><p>{project.description}</p><div class="tag-list">{project.stack.map(tag => <span class="tag">{tag}</span>)}</div>{project.note && <p class="project-note">{project.note}</p>}</div>
    <div class="index-actions">{project.case && <a class="button button-dark" href={href(`work/${project.case}/`)}>Case study <span aria-hidden="true">↗</span></a>}{project.demo && <a class="text-link" href={project.demo} target="_blank" rel="noopener">Open demo <span aria-hidden="true">↗</span></a>}{project.source && <a class="source-link" href={project.source} target="_blank" rel="noopener">Source code ↗</a>}</div>
  </article>)}</div>
</div>
<script>
  const explorer = document.querySelector('.project-explorer');
  explorer?.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.disabled = false);
  explorer?.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.addEventListener('click', () => {
    const filter = button.dataset.filter;
    explorer.querySelectorAll('[data-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    let count = 0;
    explorer.querySelectorAll<HTMLElement>('[data-category]').forEach(project => { project.hidden = filter !== 'All' && project.dataset.category !== filter; if (!project.hidden) count++; });
    const label = explorer.querySelector('.result-count');
    if (label) label.textContent = `${count} ${count === 1 ? 'project' : 'projects'}`;
  }));
</script>
