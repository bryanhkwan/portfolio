---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '../styles/global.css';
import '../styles/pages.css';
import '../styles/constellation.css';
import '../styles/arena.css';
import { href } from '../lib/paths';
const title = 'Bryan Kwan — Sports analytics & data products';
const description = 'Welcome to my home court. Explore projects, experience, and research through an interactive architectural study of Toledo’s Savage Arena.';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" class="arena-document">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030c16" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#arena-menu">Skip to portfolio navigation</a>
    <main id="main"><slot /></main>
  </body>
</html>
